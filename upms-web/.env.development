
# Dev overrides
# Point to local backend; align with dev proxy or direct origin
VITE_API_BASE_URL=/api
# Verbose logging in development
VITE_APP_LOG_LEVEL=debug
# Enable mocks in development for testing without backend
VITE_USE_MOCKS=false
# For local development, you can point to a local backend or use mocks.
VITE_API_TARGET=http://localhost:8004