    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.7"
