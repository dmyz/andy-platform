    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "run-s test:unit test:e2e"
  },
  "dependencies": {
    "@lucide/vue": "^1.14.0",
    "@vueuse/core": "^14.3.0",
